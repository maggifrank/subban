# Copy to /etc/systemd/system/subban.service inside the LXC container, then:
#   systemctl daemon-reload && systemctl enable --now subban
[Unit]
Description=Subban swim tracker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/subban
ExecStart=/usr/bin/node /opt/subban/serve.js
Environment=PORT=8080
# StateDirectory creates and owns /var/lib/subban. The app directory itself stays
# read-only under ProtectSystem=strict, so the shared count must live here.
StateDirectory=subban
Environment=SUBBAN_DATA=/var/lib/subban/state.json
# Uncomment to require an access code; every device is prompted for it once.
#Environment=SUBBAN_TOKEN=choose-something-long
Restart=on-failure
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
