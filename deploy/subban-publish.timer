# Every minute. A run with nothing new costs one local request against an
# in-memory cache and exits without deploying, so only an actual swim — or a
# fresh ECB rate once a day — reaches Netlify. No jitter: at this interval it
# would just blur the cadence it exists to smooth.
[Unit]
Description=Publish Subban's public snapshot

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
Unit=subban-publish.service

[Install]
WantedBy=timers.target
