# A safety net, not the main mechanism — sund-publish.path republishes within
# seconds of a swim. This catches a trigger missed while the publisher was down,
# and picks up the daily ECB rate when nobody has been swimming. Four no-op runs
# a day instead of 1440.
[Unit]
Description=Publish Sund's public snapshot (periodic safety net)

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
Unit=sund-publish.service

[Install]
WantedBy=timers.target
