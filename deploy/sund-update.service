# Pulls and restarts Sund if the repo has moved. Triggered by sund-update.timer.
[Unit]
Description=Update Sund from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/sund/deploy/sund-update.sh
Environment=SUND_REPO=/opt/sund
Environment=SUND_URL=http://127.0.0.1:8080
# Needs to write to /opt/sund and call systemctl, so it runs as root — unlike
# sund.service itself, which is a locked-down DynamicUser.
User=root
