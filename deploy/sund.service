# Copy to /etc/systemd/system/sund.service inside the LXC container, then:
#   systemctl daemon-reload && systemctl enable --now sund
[Unit]
Description=Sund swim tracker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sund
ExecStart=/usr/bin/node /opt/sund/serve.js
Environment=PORT=8080
# StateDirectory creates and owns /var/lib/sund. The app directory itself stays
# read-only under ProtectSystem=strict, so the shared count must live here.
StateDirectory=sund
Environment=SUND_DATA=/var/lib/sund/state.json
# Uncomment to require an access code; every device is prompted for it once.
#Environment=SUND_TOKEN=choose-something-long
Restart=on-failure
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
